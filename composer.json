{
    "name": "nsd7/laravel-activitylog-ui",
    "description": "A beautiful Tailwind CSS dashboard for Spatie Laravel Activitylog — browse, filter, diff, analyse and export your audit/activity logs. Analytics charts, timeline, saved views, dark mode, full record history, CSV/JSON/Excel/PDF export, multi-database, zero build step.",
    "type": "library",
    "keywords": [
        "laravel",
        "activitylog",
        "activity-log",
        "laravel-activitylog",
        "audit",
        "audit-log",
        "audit-trail",
        "spatie",
        "ui",
        "dashboard",
        "admin",
        "tailwind",
        "tailwindcss",
        "alpinejs",
        "logging",
        "monitoring",
        "timeline",
        "analytics",
        "history",
        "export",
        "csv",
        "laravel-package"
    ],
    "require": {
        "php": "^8.0",
        "spatie/laravel-activitylog": "^4.0",
        "laravel/framework": "^9.0 || ^10.0 || ^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0 || ^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
    },
    "suggest": {
        "maatwebsite/excel": "Enables native Excel (XLSX) export (^3.1). Without it, XLSX export falls back to CSV.",
        "barryvdh/laravel-dompdf": "Enables PDF export (^2.0 || ^3.0). Without it, PDF export falls back to JSON."
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Robiul Hasan Nowshad",
            "email": "nowshad21aug@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Nsd7\\LaravelActivitylogUi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nsd7\\LaravelActivitylogUi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nsd7\\LaravelActivitylogUi\\LaravelActivitylogUiServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.2.0"
}
